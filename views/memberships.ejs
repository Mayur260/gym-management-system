Update all CSS/JS paths to use /css and /js prefixes 
-->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Memberships — IronForge GMS</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-wrapper">
  <div id="sidebar-slot"></div>
  <main class="main-content">
    <div id="topbar-slot"></div>
    <div class="page-body">
      <section class="page-header">
        <div class="page-title">
          <h1>Membership Plans</h1>
          <p>Configure pricing and features for plans.</p>
        </div>
        <a href="/memberships/add" class="btn btn-primary">+ Add Plan</a>
      </section>

      <section class="card">
        <div class="toolbar">
          <div class="search-group">
            <input class="input-dark" type="text" placeholder="Search plans..." />
          </div>
        </div>
      </section>

      <section class="card table-card">
        <div class="table-wrap">
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Plan Name</th>
              <th>Duration (Months)</th>
              <th>Price</th>
              <th>Features</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (memberships && memberships.length > 0) { %>
              <% memberships.forEach(membership => { %>
                <tr>
                  <td><%= membership.plan_name %></td>
                  <td><%= membership.duration_months %></td>
                  <td><%= membership.price %></td>
                  <td><%= membership.features || '-' %></td>
                  <td>
                    <div class="table-actions">
                      <a href="/memberships/edit/<%= membership.id %>" class="btn btn-edit">Edit</a>
                      <form action="/memberships/delete/<%= membership.id %>" method="POST">
                        <button type="submit" class="btn btn-delete">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5">No membership plans found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </section>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<script src="/js/main.js"></script>
<script src="/js/nav.js"></script>
<script>
buildSidebar('Memberships');
</script>
</body>
</html>
