<!-- EJS Template for Dashboard
This is a basic EJS template structure. Convert the HTML dashboard to use EJS templating syntax.
Original path: gym frontend/dashboard.html
Updated path: views/dashboard.ejs
Update all CSS/JS paths to use /css and /js prefixes 
-->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — IronForge GMS</title>
  <link rel="stylesheet" href="/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div class="app-wrapper">
  <div id="sidebar-slot"></div>
  <main class="main-content">
    <div id="topbar-slot"></div>
    <div class="page-body">
      <%
        const dashboardStats = typeof stats !== 'undefined' ? stats : {
          totalMembers: 10,
          activeMemberships: 6,
          totalTrainers: 6,
          monthlyRevenue: 0,
          todayAttendanceCount: 0,
          pendingPayments: 2
        };

        const revenueChart = typeof monthlyRevenueChart !== 'undefined' ? monthlyRevenueChart : {
          labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
          values: [0, 0, 5000, 12000, 8500, 0]
        };

        const attendanceChart = typeof attendanceTrendChart !== 'undefined' ? attendanceTrendChart : {
          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
          values: [8, 5, 9, 6, 7, 4, 0]
        };

        const membershipChart = typeof membershipDistributionChart !== 'undefined' ? membershipDistributionChart : {
          labels: ['Monthly', 'Quarterly', 'Annual'],
          values: [3, 2, 1]
        };

        const safeRevenueLabels = typeof revenueLabels !== 'undefined' ? revenueLabels : revenueChart.labels;
        const safeRevenueValues = typeof revenueValues !== 'undefined' ? revenueValues : revenueChart.values;
        const safeAttendanceLabels = typeof attendanceLabels !== 'undefined' ? attendanceLabels : attendanceChart.labels;
        const safeAttendanceValues = typeof attendanceValues !== 'undefined' ? attendanceValues : attendanceChart.values;
        const safeMembershipLabels = typeof membershipLabels !== 'undefined' ? membershipLabels : membershipChart.labels;
        const safeMembershipValues = typeof membershipValues !== 'undefined' ? membershipValues : membershipChart.values;

        const activityItems = typeof recentActivity !== 'undefined' ? recentActivity : [
          { type: 'member', text: 'Aarav Sharma joined with Annual plan', time: '10 min ago' },
          { type: 'payment', text: 'Payment of Rs 2,500 received from Riya Patel', time: '25 min ago' },
          { type: 'attendance', text: 'Today attendance marked for morning batch', time: '40 min ago' },
          { type: 'member', text: 'Sneha Verma profile updated', time: '1 hr ago' }
        ];

        const dashboardRecentMembers = typeof recentMembers !== 'undefined' ? recentMembers : [
          { full_name: 'Arjun Singh', plan_name: 'Annual', membership_status: 'active', join_date: '2026-05-12' },
          { full_name: 'Meera Kapoor', plan_name: 'Quarterly', membership_status: 'expiring', join_date: '2026-05-09' },
          { full_name: 'Rohan Das', plan_name: 'Monthly', membership_status: 'active', join_date: '2026-05-07' },
          { full_name: 'Pooja Nair', plan_name: 'Annual', membership_status: 'pending', join_date: '2026-05-05' }
        ];
      %>

      <section class="page-header">
        <div class="page-title">
          <h1>Dashboard</h1>
          <p>Overview of your gym operations and performance.</p>
        </div>
      </section>

      <section class="stats-grid">
        <div class="stat-card">
          <h3>Total Members</h3>
          <p><%= dashboardStats.totalMembers %></p>
        </div>
        <div class="stat-card">
          <h3>Active Memberships</h3>
          <p><%= dashboardStats.activeMemberships %></p>
        </div>
        <div class="stat-card">
          <h3>Total Trainers</h3>
          <p><%= dashboardStats.totalTrainers %></p>
        </div>
        <div class="stat-card">
          <h3>Monthly Revenue</h3>
          <p>Rs <%= Number(dashboardStats.monthlyRevenue || 0).toLocaleString('en-IN') %></p>
        </div>
        <div class="stat-card">
          <h3>Today's Attendance</h3>
          <p><%= dashboardStats.todayAttendanceCount %></p>
        </div>
        <div class="stat-card">
          <h3>Pending Payments</h3>
          <p><%= dashboardStats.pendingPayments %></p>
        </div>
      </section>

      <section class="charts-grid">
        <div class="chart-card">
          <h3>Monthly Revenue</h3>
          <canvas id="dashboardRevenueChart"></canvas>
        </div>
        <div class="chart-card">
          <h3>Attendance Trend</h3>
          <canvas id="dashboardAttendanceChart"></canvas>
        </div>
        <div class="chart-card">
          <h3>Membership Distribution</h3>
          <canvas id="dashboardMembershipChart"></canvas>
        </div>
      </section>

      <section class="card">
        <div class="toolbar">
          <div class="page-title">
            <h1 style="font-size:16px;">Quick Actions</h1>
            <p>Fast access to frequent tasks.</p>
          </div>
          <div class="table-actions">
            <a href="/members/add" class="btn btn-primary">Add Member</a>
            <a href="/trainers/add" class="btn btn-ghost">Add Trainer</a>
            <a href="/payments/add" class="btn btn-ghost">Record Payment</a>
            <a href="/attendance/add" class="btn btn-ghost">Mark Attendance</a>
          </div>
        </div>
      </section>

      <section class="charts-grid">
        <div class="card">
          <div class="page-title">
            <h1 style="font-size:16px;">Recent Activity</h1>
            <p>Latest updates from members, payments, and attendance.</p>
          </div>
          <div style="margin-top:12px; display:grid; gap:10px;">
            <% activityItems.forEach((item) => { %>
              <div style="display:flex; justify-content:space-between; gap:10px; padding:10px 12px; border:1px solid var(--border); border-radius:10px; background:var(--bg-elevated);">
                <span style="font-size:13px; color:var(--text-primary);"><%= item.text %></span>
                <span style="font-size:11px; color:var(--text-muted); white-space:nowrap;"><%= item.time %></span>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="card table-card">
          <div style="padding:16px 16px 0;">
            <div class="page-title">
              <h1 style="font-size:16px;">Recent Members</h1>
              <p>Latest member enrollments.</p>
            </div>
          </div>
          <div class="table-wrap" style="margin-top:12px;">
            <table class="dashboard-table" style="min-width:100%;">
              <thead>
                <tr>
                  <th>Member Name</th>
                  <th>Plan</th>
                  <th>Status</th>
                  <th>Join Date</th>
                </tr>
              </thead>
              <tbody>
                <% dashboardRecentMembers.forEach((member) => { %>
                  <% const status = (member.membership_status || '').toLowerCase(); %>
                  <tr>
                    <td><%= member.full_name %></td>
                    <td><%= member.plan_name || '-' %></td>
                    <td>
                      <span class="status-badge <%= status === 'active' ? 'badge-active' : status === 'expiring' ? 'badge-expiring' : status === 'pending' ? 'badge-pending' : status === 'expired' ? 'badge-expired' : 'badge-neutral' %>">
                        <%= member.membership_status || '-' %>
                      </span>
                    </td>
                    <td><%= member.join_date || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<script src="/js/main.js"></script>
<script src="/js/nav.js"></script>
<script>
buildSidebar('Dashboard');

const revenueLabels = <%- JSON.stringify(safeRevenueLabels || []) %>;
const revenueValues = <%- JSON.stringify(safeRevenueValues || []) %>;
const attendanceLabels = <%- JSON.stringify(safeAttendanceLabels || []) %>;
const attendanceValues = <%- JSON.stringify(safeAttendanceValues || []) %>;
const membershipLabels = <%- JSON.stringify(safeMembershipLabels || []) %>;
const membershipValues = <%- JSON.stringify(safeMembershipValues || []) %>;

new Chart(document.getElementById('dashboardRevenueChart'), {
  type: 'line',
  data: {
    labels: revenueLabels,
    datasets: [{
      label: 'Revenue',
      data: revenueValues,
      borderColor: '#10B981',
      backgroundColor: 'rgba(16, 185, 129, 0.14)',
      fill: true,
      tension: 0.35
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { labels: { color: '#8A9BB5' } } },
    scales: {
      x: { ticks: { color: '#8A9BB5' }, grid: { color: 'rgba(138,155,181,0.10)' } },
      y: { ticks: { color: '#8A9BB5' }, grid: { color: 'rgba(138,155,181,0.10)' } }
    }
  }
});

new Chart(document.getElementById('dashboardAttendanceChart'), {
  type: 'bar',
  data: {
    labels: attendanceLabels,
    datasets: [{
      label: 'Attendance',
      data: attendanceValues,
      backgroundColor: 'rgba(59, 130, 246, 0.6)',
      borderColor: '#3B82F6',
      borderWidth: 1
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { labels: { color: '#8A9BB5' } } },
    scales: {
      x: { ticks: { color: '#8A9BB5' }, grid: { color: 'rgba(138,155,181,0.08)' } },
      y: { ticks: { color: '#8A9BB5' }, grid: { color: 'rgba(138,155,181,0.08)' } }
    }
  }
});

new Chart(document.getElementById('dashboardMembershipChart'), {
  type: 'doughnut',
  data: {
    labels: membershipLabels,
    datasets: [{
      label: 'Members',
      data: membershipValues,
      backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#8B5CF6']
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { labels: { color: '#8A9BB5' } } }
  }
});
</script>
</body>
</html>
