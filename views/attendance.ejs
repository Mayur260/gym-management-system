<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance — IronForge GMS</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="app-wrapper">
  <div id="sidebar-slot"></div>
  <main class="main-content">
    <div id="topbar-slot"></div>
    <div class="page-body">
      <section class="page-header">
        <div class="page-title">
          <h1>Attendance</h1>
          <p>Monitor daily check-ins and member presence.</p>
        </div>
        <a href="/attendance/add" class="btn btn-primary">+ Add Attendance</a>
      </section>

      <section class="card">
        <div class="toolbar">
          <div class="search-group">
            <input class="input-dark" type="text" placeholder="Search attendance..." />
            <select class="select-dark">
              <option>All Status</option>
              <option>Present</option>
              <option>Absent</option>
              <option>Late</option>
            </select>
          </div>
        </div>
      </section>

      <section class="card table-card">
        <div class="table-wrap">
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Member Name</th>
              <th>Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (attendanceRecords && attendanceRecords.length > 0) { %>
              <% attendanceRecords.forEach(record => { %>
                <% const status = (record.status || '').toLowerCase(); %>
                <tr>
                  <td><%= record.full_name || 'Unknown Member' %></td>
                  <td><%= record.attendance_date %></td>
                  <td><%= record.check_in_time || '-' %></td>
                  <td><%= record.check_out_time || '-' %></td>
                  <td>
                    <span class="status-badge <%= status === 'present' ? 'badge-present' : status === 'absent' ? 'badge-absent' : status === 'late' ? 'badge-late' : 'badge-neutral' %>">
                      <%= record.status %>
                    </span>
                  </td>
                  <td>
                    <div class="table-actions">
                      <a href="/attendance/edit/<%= record.id %>" class="btn btn-edit">Edit</a>
                      <form action="/attendance/delete/<%= record.id %>" method="POST">
                        <button type="submit" class="btn btn-delete">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">No attendance records found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      </section>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<script src="/js/main.js"></script>
<script src="/js/nav.js"></script>
<script>
buildSidebar('Attendance');
</script>
</body>
</html>
